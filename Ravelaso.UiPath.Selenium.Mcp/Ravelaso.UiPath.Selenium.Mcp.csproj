<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import central versioning -->
  <Import Project="..\Version.props" />
  
  <PropertyGroup>

    <!-- Build Counter (unique per build: HHMM format - hours and minutes) -->
    <BuildCounter>$([System.DateTime]::UtcNow.ToString("HHmm"))</BuildCounter>

    <!-- Version Strategy: Fixed Release (1.1.0) + Auto-increment Debug (1.1.0-build0HHMM) -->
    <VersionPrefix Condition="'$(Configuration)' == 'Release'">$(VersionMajor).$(VersionMinor).$(VersionPatch)</VersionPrefix>
    <VersionPrefix Condition="'$(Configuration)' == 'Debug'">$(VersionMajor).$(VersionMinor).$(VersionPatch)-build$(BuildCounter)</VersionPrefix>
    
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ravelaso.UiPath.Selenium.Core\Ravelaso.UiPath.Selenium.Core.csproj" />
  </ItemGroup>

  <!-- Embed library docs so they ship inside the published exe -->
  <ItemGroup>
    <EmbeddedResource Include="..\README.md" Link="Resources\README.md" />
    <EmbeddedResource Include="..\docs\QUICKSTART.md" Link="Resources\QUICKSTART.md" />
  </ItemGroup>

</Project>
