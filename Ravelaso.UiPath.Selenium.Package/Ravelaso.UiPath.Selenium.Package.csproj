<Project Sdk="Microsoft.NET.Sdk">

    <!-- Import central versioning -->
    <Import Project="..\Version.props" />

    <PropertyGroup>
        <!-- Build Counter (unique per build: HHMM format - hours and minutes) -->
        <BuildCounter>$([System.DateTime]::UtcNow.ToString("HHmm"))</BuildCounter>
        
        <!-- Version Strategy: Fixed Release (1.1.0) + Auto-increment Debug (1.1.0-build0HHMM) -->
        <VersionPrefix Condition="'$(Configuration)' == 'Release'">$(VersionMajor).$(VersionMinor).$(VersionPatch)</VersionPrefix>
        <VersionPrefix Condition="'$(Configuration)' == 'Debug'">$(VersionMajor).$(VersionMinor).$(VersionPatch)-build$(BuildCounter)</VersionPrefix>
        
        <!-- Build Configuration -->
        <OutputType>Library</OutputType>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- NuGet Pack Settings: Auto-pack in both Release and Debug -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>$(SolutionDir)dist</PackageOutputPath>
        <IncludeSymbols>false</IncludeSymbols>
        <IncludeSource>false</IncludeSource>
        <DeterministicSourcePaths Condition="'$(Configuration)' == 'Release'">true</DeterministicSourcePaths>

        <!-- Runtime Assets: Ensure selenium-manager.exe is included -->
        <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- Reference Core Library -->
    <ItemGroup>
        <ProjectReference Include="..\Ravelaso.UiPath.Selenium.Core\Ravelaso.UiPath.Selenium.Core.csproj" />
    </ItemGroup>

    <!-- Pack dependencies (transitive) + runtimes -->
    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>
            $(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage
        </TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>
    
    <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" />
        </ItemGroup>
    </Target>

    <!-- Copy runtimes folder for packing (post-build) -->
    <Target Name="CopyRuntimesToPackage" AfterTargets="Build">
        <ItemGroup>
            <RuntimeAssets Include="$(OutputPath)runtimes\**\*" />
        </ItemGroup>
        <Message Text="Copying runtime assets from: $(OutputPath)runtimes\" Importance="high" />
        <Copy SourceFiles="@(RuntimeAssets)" DestinationFiles="@(RuntimeAssets->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

    <!-- Include in pack -->
    <ItemGroup>
        <None Include="$(OutputPath)runtimes\**\*" Pack="true" PackagePath="runtimes\%(RecursiveDir)" />
    </ItemGroup>

    <!-- Include Documentation in Package -->
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\docs\**\*.md" Pack="true" PackagePath="docs\" />
    </ItemGroup>

</Project>
